# =============================================
# FusionCareer 生产环境变量
# 部署位置：服务器 /data/fusioncareer/.env.production
# ⚠️ 此文件包含敏感信息，禁止提交到 Git 仓库
# =============================================

# ── 复旦 SSO OAuth2 凭证 ──
# 向复旦信息化中心申请后获得
FUDAN_SSO_CLIENT_ID=your_client_id_here
FUDAN_SSO_CLIENT_SECRET=your_client_secret_here

# ── 数据库 ──
DB_URL=jdbc:mysql://127.0.0.1:3306/fusioncareer?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowMultiQueries=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# ── 个人空间变更历史加密 ──
# 使用 openssl rand -base64 32 生成；丢失后历史快照无法回退
USER_CHANGE_KEY=your_base64_encoded_32_byte_key
USER_CHANGE_KEY_VERSION=1
# 密钥轮换时保留旧版本：1=old_base64,2=new_base64
# USER_CHANGE_KEYS=

# ── AgentContext HMAC ──
AGENT_CONTEXT_SECRET=your_independent_random_secret_at_least_32_bytes

# ── Agent 服务 LLM 配置 ──
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
