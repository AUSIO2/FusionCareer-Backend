# Java 后端地址
BACKEND_BASE_URL=http://localhost:9100

# OpenAI 兼容 LLM 配置
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
JOB_STRUCTURE_MODE=chunked
JOB_STRUCTURE_SHORT_ARTICLE_CHARS=6000
JOB_STRUCTURE_BLOCK_MAX_CHARS=8000
JOB_STRUCTURE_BLOCK_OVERLAP_CHARS=400
JOB_STRUCTURE_DETAIL_BATCH_JOBS=4
JOB_STRUCTURE_DETAIL_CONTEXT_CHARS=12000
JOB_STRUCTURE_INDEX_CONCURRENCY=3
JOB_STRUCTURE_ARTICLE_CONCURRENCY=3
JOB_STRUCTURE_MAX_ATTEMPTS=3
JOB_STRUCTURE_CLAIM_LEASE_SECONDS=7200

# Agent 服务端口
AGENT_PORT=8900

# 热更新 runtime 目录（数据类 / workflow / skill）
AGENT_RUNTIME_DIR=./runtime

# 管理员 API Token（请求头 X-Agent-Admin-Token）
AGENT_ADMIN_TOKEN=change-me-in-production
INTERNAL_SERVICE_TOKEN=change-me-in-production

# 定时任务时区
SCHEDULE_TIMEZONE=Asia/Shanghai

# 微信公众号爬虫（Token/Cookie 只放服务器环境，勿提交）
WECHAT_CONFIG_ROOT=
WECHAT_TOKEN=
WECHAT_COOKIE=
# 按 Tool 名覆盖只读/写提案/解析默认超时（JSON，单位秒）
AI_CHAT_TOOL_TIMEOUTS={"recommend_jobs":110,"search_jobs":8,"parse_resume_file":90,"analyze_resume_file":90,"advise_resume":150}
AI_CHAT_RECOMMEND_ENABLED=true
AI_CHAT_READ_TOOL_TIMEOUT_SECONDS=3
AI_CHAT_WRITE_TOOL_TIMEOUT_SECONDS=15
AI_CHAT_PARSE_TIMEOUT_SECONDS=90
RESUME_PARSER_VERSION=261013
# 解析日志含个人经历；Agent 集成默认不落盘，确需排障时再临时启用。
RESUME_MODEL_IO_LOG_ENABLED=false
RESUME_MODEL_IO_LOG_MAX_TEXT_CHARS=120000
RESUME_MODEL_IO_ACTOR_HMAC_SECRET=
AI_CHAT_RECOMMEND_TIMEOUT_SECONDS=110
AI_CHAT_RUN_TIMEOUT_SECONDS=180
AI_CHAT_RESUME_ADVICE_ENABLED=true
AI_CHAT_RESUME_ADVICE_TIMEOUT_SECONDS=150
AI_CHAT_RESUME_ADVICE_LLM_TIMEOUT_SECONDS=45
AI_CHAT_TOPIC_GUARD_ENABLED=true
AI_CHAT_TOPIC_MODEL=deepseek-v4-flash
AI_CHAT_TOPIC_TIMEOUT_SECONDS=6
RECOMMENDATION_LLM_ENABLED=true
RECOMMENDATION_LLM_TIMEOUT_SECONDS=15
# 生产发布已选择启用；本地如不需要外部请求或审计可改为 false
RECOMMENDATION_COMPANY_SCORE_ENABLED=true
RECOMMENDATION_AUDIT_LOG_ENABLED=true
PREFILTER_ENABLED=true
PREFILTER_MIN_HITS=1
JOB_RECORD_DEDUP_ENABLED=true
ARTICLE_DEDUP_ENABLED=true
ARTICLE_DEDUP_NGRAM=3
ARTICLE_DEDUP_NUM_PERM=128
ARTICLE_DEDUP_LSH_THRESHOLD=0.6
ARTICLE_DEDUP_JACCARD_THRESHOLD=0.85
