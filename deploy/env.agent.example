# Python 机 .env.agent（复制到 fusioncareer-agent/.env.agent，勿提交 Git）
# cp deploy/env.agent.example fusioncareer-agent/.env.agent

# Java 后端内网地址（Agent 调用 /internal/**）
BACKEND_BASE_URL=http://172.22.130.216:9100
INTERNAL_SERVICE_TOKEN=与Java机保持一致
AI_CHAT_WRITE_ENABLED=false
AI_CHAT_RECOMMEND_ENABLED=true
AI_CHAT_RUN_TIMEOUT_SECONDS=120
AI_CHAT_READ_TOOL_TIMEOUT_SECONDS=3
AI_CHAT_WRITE_TOOL_TIMEOUT_SECONDS=15
AI_CHAT_PARSE_TIMEOUT_SECONDS=90
AI_CHAT_RECOMMEND_TIMEOUT_SECONDS=30
# Tool 名称覆盖分类默认值；正数秒。单轮总时限仍由 RUN_TIMEOUT 限制。
AI_CHAT_TOOL_TIMEOUTS={"recommend_jobs":30,"parse_resume_file":90}
RECOMMENDATION_LLM_ENABLED=true
RECOMMENDATION_LLM_TIMEOUT_SECONDS=15
# 外部市值查询可能显著增加延迟；审计日志会包含偏好/简历摘要，默认均关闭。
RECOMMENDATION_COMPANY_SCORE_ENABLED=false
RECOMMENDATION_AUDIT_LOG_ENABLED=false
PREFILTER_ENABLED=true
PREFILTER_MIN_HITS=1
AI_CHAT_MAX_CONCURRENCY=16
AGENT_ADMIN_TOKEN=生成独立随机管理密钥

# LLM（OpenAI 兼容接口，按实际填写）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=在此填写
LLM_MODEL=gpt-4o-mini

# 微信公众号后台会话（过期后在服务器更新）
WECHAT_TOKEN=
WECHAT_COOKIE=
