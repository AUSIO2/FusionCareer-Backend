# Java 机 SSH 反向隧道配置（复制为 .env.tunnel，勿提交 Git）
# cp deploy/env.tunnel.example .env.tunnel
#
# 与 backend 一起启动:
#   docker compose -f deploy/docker-compose.java.image.yml \
#     -f deploy/docker-compose.java.tunnel.yml --env-file .env.production --env-file .env.tunnel up -d

PYTHON_HOST=10.107.13.184
PYTHON_USER=vmadmin
PYTHON_SSH_PORT=22

# Java 本机 backend（compose 映射到宿主机 9100）
LOCAL_BACKEND=127.0.0.1:9100

# Python 宿主机上监听地址（Nginx upstream 用 127.0.0.1:19100）
REMOTE_BIND=127.0.0.1:19100

# 宿主机私钥路径（须已对 Python 机配置免密: ssh-copy-id）
SSH_KEY_PATH=/root/.ssh/id_ed25519_py
