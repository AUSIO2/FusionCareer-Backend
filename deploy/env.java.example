# Java 机 .env.production（复制到项目根目录，勿提交 Git）
# cp deploy/env.java.example .env.production

# ── 复旦 SSO（向信息化中心申请）──
FUDAN_SSO_CLIENT_ID=fusioncareer
FUDAN_SSO_CLIENT_SECRET=在此填写_secret_勿提交仓库
FUDAN_SSO_REDIRECT_URI=https://fusioncareer.fudan.edu.cn/fudan/callback
# 登录成功后浏览器落地页（必须是站点根，不要写成 /user）
FUDAN_SSO_FRONTEND_REDIRECT_URL=https://fusioncareer.fudan.edu.cn/

# ── MySQL ──
DB_PASSWORD=在此填写强密码

# ── Python 机 Agent（Java 调 AI 时用；经 Python 网关）──
# Agent 位于 Python 机: 10.107.13.184
PYTHON_SERVICE_BASE_URL=http://10.107.13.184:8900
INTERNAL_SERVICE_TOKEN=生成随机服务间密钥

# ── 个人空间变更历史（openssl rand -base64 32）──
USER_CHANGE_KEY=在此填写Base64编码的32字节随机密钥
USER_CHANGE_KEY_VERSION=1
# 轮换后保留旧密钥，格式：1=旧Base64,2=新Base64
# USER_CHANGE_KEYS=

# ── AgentContext HMAC（至少32字节，与登录Token、LLM Key分离）──
AGENT_CONTEXT_SECRET=在此填写独立随机密钥
